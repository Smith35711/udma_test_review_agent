# 模型配置：多模型列表见 config/models.yaml，切换用 LLM_PROFILE 或接口参数
# 模型配置文件路径（可选，默认 agent/config/models.yaml）
# MODEL_CONFIG=/path/to/models.yaml
# 当前启用模型名称（可选，覆盖 config/models.yaml 的 active）
# LLM_PROFILE=deepseek-chat

# 模型密钥（供 config/models.yaml 中 ${DEEPSEEK_API_KEY} / ${OPENCODE_API_KEY} 引用）
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=

# 控制台日志级别（命令行 --log-level 优先于此处；日志文件 output/llm_test.log 始终记录 DEBUG）
LOG_LEVEL=INFO
